// PeoplePay360 database schema.
// Source of truth: ../../docs/01_DATABASE_SCHEMA.md — keep this file and that doc in sync.
// Table names and columns are snake_case (mapped via @@map/@map) to match the agreed schema doc;
// Prisma-side field/model names stay camelCase/PascalCase for idiomatic TS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Access control ----------

model Role {
  id            String         @id @default(uuid())
  name          String         @unique
  isSystemRole  Boolean        @default(false) @map("is_system_role")
  rolePermissions RolePermission[]
  userRoles     UserRole[]

  @@map("roles")
}

model Permission {
  id     String @id @default(uuid())
  module String
  action String
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  scope        String?
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id             String     @id @default(uuid())
  employeeId     String?    @unique @map("employee_id")
  email          String     @unique
  passwordHash   String     @map("password_hash")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  employee       Employee?  @relation(fields: [employeeId], references: [id])
  userRoles      UserRole[]
  auditLogs      AuditLog[]
  computedPayruns  Payrun[] @relation("PayrunComputedBy")
  validatedPayruns Payrun[] @relation("PayrunValidatedBy")

  @@map("users")
}

model UserRole {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  roleId        String    @map("role_id")
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  grantedBy     String?   @map("granted_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("user_roles")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  module      String
  action      String
  recordId    String?  @map("record_id")
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

// ---------- HR core ----------

enum EmployeeStatus {
  active
  inactive
}

model Department {
  id                 String       @id @default(uuid())
  name               String
  parentDepartmentId String?      @map("parent_department_id")
  headEmployeeId     String?      @map("head_employee_id")

  parentDepartment Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  children         Department[] @relation("DepartmentHierarchy")
  headEmployee     Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  employees        Employee[]   @relation("EmployeeDepartment")
  contracts        Contract[]

  @@map("departments")
}

model WorkingSchedule {
  id          String @id @default(uuid())
  name        String
  type        String
  weeklyHours Decimal @default(0) @map("weekly_hours") @db.Decimal(6, 2)

  lines     ScheduleLine[]
  employees Employee[]

  @@map("working_schedules")
}

model ScheduleLine {
  id         String   @id @default(uuid())
  scheduleId String   @map("schedule_id")
  day        String
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  breakMins  Int      @default(0) @map("break")

  schedule WorkingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("schedule_lines")
}

model Employee {
  id                 String         @id @default(uuid())
  departmentId       String?        @map("department_id")
  managerId          String?        @map("manager_id")
  workingScheduleId  String?        @map("working_schedule_id")
  name               String
  jobPosition        String?        @map("job_position")
  status             EmployeeStatus @default(active)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  department       Department?      @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  manager          Employee?        @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates     Employee[]       @relation("EmployeeManager")
  workingSchedule  WorkingSchedule? @relation(fields: [workingScheduleId], references: [id])
  headOfDepartments Department[]    @relation("DepartmentHead")
  user             User?
  contracts        Contract[]
  attendance       Attendance[]
  timeOffAllocations TimeOffAllocation[]
  timeOffRequests    TimeOffRequest[]
  payslips           Payslip[]

  @@map("employees")
}

enum ContractStatus {
  draft
  active
  expired
  cancelled
}

model Contract {
  id                 String         @id @default(uuid())
  employeeId         String         @map("employee_id")
  departmentId       String?        @map("department_id")
  position           String?
  wage               Decimal        @db.Decimal(12, 2)
  salaryStructureId  String?        @map("salary_structure_id")
  startDate          DateTime       @map("start_date") @db.Date
  endDate            DateTime?      @map("end_date") @db.Date
  status             ContractStatus @default(draft)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  employee       Employee        @relation(fields: [employeeId], references: [id])
  department     Department?     @relation(fields: [departmentId], references: [id])
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  payslips       Payslip[]

  @@map("contracts")
}

enum AttendanceStatus {
  present
  late
  absent
  manual_edit
}

model Attendance {
  id          String            @id @default(uuid())
  employeeId  String            @map("employee_id")
  checkIn     DateTime          @map("check_in")
  checkOut    DateTime?         @map("check_out")
  workedHours Decimal           @default(0) @map("worked_hours") @db.Decimal(5, 2)
  status      AttendanceStatus  @default(present)
  correctedBy String?           @map("corrected_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("attendance")
}

// ---------- Time off ----------

model TimeOffType {
  id                 String  @id @default(uuid())
  name               String
  unit               String  @default("days")
  requiresAllocation Boolean @default(true) @map("requires_allocation")
  payrollIntegration Boolean @default(true) @map("payroll_integration")

  allocations TimeOffAllocation[]
  requests    TimeOffRequest[]

  @@map("time_off_types")
}

enum AllocationStatus {
  draft
  validate
  refused
}

model TimeOffAllocation {
  id         String            @id @default(uuid())
  employeeId String            @map("employee_id")
  typeId     String            @map("type_id")
  allocated  Decimal           @db.Decimal(6, 2)
  taken      Decimal           @default(0) @db.Decimal(6, 2)
  validFrom  DateTime?         @map("valid_from") @db.Date
  validTo    DateTime?         @map("valid_to") @db.Date
  status     AllocationStatus  @default(draft)

  employee Employee    @relation(fields: [employeeId], references: [id])
  type     TimeOffType @relation(fields: [typeId], references: [id])

  @@map("time_off_allocations")
}

enum TimeOffRequestStatus {
  draft
  validate
  refused
}

model TimeOffRequest {
  id         String                @id @default(uuid())
  employeeId String                @map("employee_id")
  typeId     String                @map("type_id")
  dateFrom   DateTime              @map("date_from") @db.Date
  dateTo     DateTime              @map("date_to") @db.Date
  duration   Decimal               @db.Decimal(6, 2)
  status     TimeOffRequestStatus  @default(draft)

  employee Employee    @relation(fields: [employeeId], references: [id])
  type     TimeOffType @relation(fields: [typeId], references: [id])

  @@map("time_off_requests")
}

// ---------- Payroll ----------

model SalaryStructure {
  id     String  @id @default(uuid())
  name   String
  active Boolean @default(true)

  rules     SalaryRule[]
  contracts Contract[]
  payruns   Payrun[]

  @@map("salary_structures")
}

enum SalaryRuleCategory {
  basic
  allowance
  gross
  deduction
  net
}

enum ComputationMethod {
  fixed
  percentage
  formula
}

model SalaryRule {
  id                String             @id @default(uuid())
  structureId       String             @map("structure_id")
  name              String
  code              String
  category          SalaryRuleCategory
  sequence          Int
  computationMethod ComputationMethod  @map("computation_method")
  fixedAmount       Decimal?           @map("fixed_amount") @db.Decimal(12, 2)
  percentage        Decimal?           @db.Decimal(6, 3)
  baseField         String?            @map("base_field")
  formula           String?

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  lines     PayslipLine[]

  @@unique([structureId, sequence])
  @@map("salary_rules")
}

enum PayrunStatus {
  draft
  computed
  validated
  paid
}

model Payrun {
  id            String       @id @default(uuid())
  structureId   String       @map("structure_id")
  periodStart   DateTime     @map("period_start") @db.Date
  periodEnd     DateTime     @map("period_end") @db.Date
  status        PayrunStatus @default(draft)
  computedBy    String?      @map("computed_by")
  validatedBy   String?      @map("validated_by")
  createdAt     DateTime     @default(now()) @map("created_at")

  structure       SalaryStructure @relation(fields: [structureId], references: [id])
  computedByUser  User?           @relation("PayrunComputedBy", fields: [computedBy], references: [id])
  validatedByUser User?           @relation("PayrunValidatedBy", fields: [validatedBy], references: [id])
  payslips        Payslip[]

  @@map("payruns")
}

enum PayslipStatus {
  draft
  computed
  validated
  paid
}

model Payslip {
  id          String        @id @default(uuid())
  payrunId    String        @map("payrun_id")
  employeeId  String        @map("employee_id")
  contractId  String?       @map("contract_id")
  workedDays  Decimal       @default(0) @map("worked_days") @db.Decimal(5, 2)
  basic       Decimal       @default(0) @db.Decimal(12, 2)
  allowances  Decimal       @default(0) @db.Decimal(12, 2)
  deductions  Decimal       @default(0) @db.Decimal(12, 2)
  gross       Decimal       @default(0) @db.Decimal(12, 2)
  net         Decimal       @default(0) @db.Decimal(12, 2)
  status      PayslipStatus @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at")

  payrun   Payrun        @relation(fields: [payrunId], references: [id])
  employee Employee      @relation(fields: [employeeId], references: [id])
  contract Contract?     @relation(fields: [contractId], references: [id])
  lines    PayslipLine[]

  @@unique([payrunId, employeeId])
  @@map("payslips")
}

model PayslipLine {
  id        String             @id @default(uuid())
  payslipId String             @map("payslip_id")
  ruleId    String             @map("rule_id")
  category  SalaryRuleCategory
  name      String
  amount    Decimal            @db.Decimal(12, 2)

  payslip Payslip    @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  rule    SalaryRule @relation(fields: [ruleId], references: [id])

  @@map("payslip_lines")
}
