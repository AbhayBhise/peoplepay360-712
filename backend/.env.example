# Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL="http://localhost:5173"

# CORS configuration (comma separated origins). Falls back to FRONTEND_URL if unset
# CORS_ORIGIN="http://localhost:5173"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peoplepay360?schema=public"

# Authentication
# Secret must be at least 32 characters in production. We pin to HS256 algorithm.
JWT_SECRET="change-me-to-a-long-random-string-with-at-least-32-chars"
JWT_EXPIRES_IN="8h"
# BCRYPT_ROUNDS=12

# Payslip email delivery. If SMTP_HOST is unset, emails are logged instead of sent
# (nodemailer jsonTransport) — safe default for local dev and demos, no real credentials
# needed. Set these to send real email through any SMTP provider.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=payroll@peoplepay360.local
COMPANY_NAME="PeoplePay360 Inc."
