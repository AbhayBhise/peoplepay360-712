DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peoplepay360?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=4000

# Payslip email delivery. If SMTP_HOST is unset, emails are logged instead of sent
# (nodemailer jsonTransport) — safe default for local dev and demos, no real credentials
# needed. Set these to send real email through any SMTP provider.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=payroll@peoplepay360.local
COMPANY_NAME="PeoplePay360 Inc."
